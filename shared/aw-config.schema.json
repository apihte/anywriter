{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aw-config.schema.json",
  "title": "AnyWriter Project Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "language": {
      "enum": ["zh", "en"],
      "default": "zh"
    },
    "writer_prompt": {
      "type": "string",
      "description": "Appended to the writing-flow agents (aw-director, aw-analyst, aw-reviewer)."
    },
    "caption_prompt": {
      "type": "string",
      "description": "Appended system prompt for the aw-caption skill."
    }
  },
  "required": ["version"],
  "default": {
    "version": 1,
    "language": "zh",
    "writer_prompt": "",
    "caption_prompt": ""
  }
}

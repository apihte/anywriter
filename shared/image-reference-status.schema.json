{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "image-reference-status.schema.json",
  "title": "Image Reference Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slug",
    "state",
    "images",
    "active_reference",
    "approvals",
    "linked_task",
    "drafts",
    "next_actions",
    "updated_at"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "state": {
      "enum": [
        "pending_approval",
        "approved",
        "drafted"
      ]
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "active_reference": {
      "type": ["string", "null"]
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "decision", "recorded_at"],
        "properties": {
          "artifact": {"type": "string"},
          "decision": {"enum": ["approved", "rejected", "changes_requested"]},
          "recorded_at": {"type": "string", "format": "date-time"},
          "note": {"type": "string"}
        }
      }
    },
    "linked_task": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "drafts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "next_actions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"state": {"const": "pending_approval"}},
        "required": ["state"]
      },
      "then": {
        "properties": {
          "active_reference": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"state": {"enum": ["approved", "drafted"]}},
        "required": ["state"]
      },
      "then": {
        "properties": {
          "active_reference": {"type": "string", "minLength": 1},
          "approvals": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "artifact": {"type": "string", "pattern": "/image-ref-v[1-9][0-9]*\\.md$"},
                "decision": {"const": "approved"}
              },
              "required": ["artifact", "decision"]
            },
            "minContains": 1
          }
        }
      }
    }
  ]
}
